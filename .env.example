# Digital Unit Portal — environment variables
# Copy to .env.local for local development. Credentials NEVER reach the browser
# (constraint #7): every variable here is server-side only.

# --- Auth.js / corporate OIDC (M2) ---
AUTH_SECRET=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT=

# --- GitHub App / application identity (M3+) ---
# The single fleet-wide write identity. Scoped to uc-* repos and the portal repo.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=
GITHUB_WEBHOOK_SECRET=
# Dedicated repo for the Skills & Playbooks registry (edits open PRs here).
REGISTRY_REPO=du-agent-registry

# --- Model service (M5+) ---
# The portal supports Anthropic and OpenAI. Selection: MODEL_PROVIDER if set and
# its key is present, else Anthropic if keyed, else OpenAI if keyed, else offline.
# MODEL_PROVIDER=anthropic   # anthropic | openai | offline (optional override)

# Anthropic (EU region), server-side only
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI, server-side only
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o

# --- Job / registry cache store (M3+) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Scheduled jobs shared secret (M5+) ---
CRON_SECRET=

# --- Agent global kill switch (constraint / FR-6.6) ---
# Set to "off" to disable ALL agent tools in one change.
AGENT_TOOLS=on
