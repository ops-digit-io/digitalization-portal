# Digital Unit Portal — environment variables
# Copy to .env.local for local development. Credentials NEVER reach the browser
# (constraint #7): every variable here is server-side only.

# --- Corporate OIDC single sign-on (real login) ---
# Login goes live when ISSUER + CLIENT_ID + CLIENT_SECRET + AUTH_SECRET are all
# set; until then the portal runs on the demo session. Register the redirect URI
# <your-app-url>/api/auth/callback with your IdP (Entra ID, Okta, Keycloak, …).
# Roles + plant scopes come from the user's IdP groups (DU-Portal-* — see
# registry/rbac.md); a plant-scoped role uses a suffix, e.g. DU-Portal-Champions-DE-ALD.
AUTH_SECRET=              # long random string; signs the session cookie
OIDC_ISSUER=             # e.g. https://login.microsoftonline.com/<tenant>/v2.0
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_TENANT=
# OIDC_GROUPS_CLAIM=groups          # id-token claim holding the group list (default: groups)
# OIDC_SCOPE=openid profile email groups   # override the requested scopes if needed

# --- GitHub App / application identity (M3+) ---
# The single fleet-wide write identity. Scoped to uc-* repos and the portal repo.
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
# Optional — the app discovers the installation from the org automatically.
# Leave it blank; only set it to pin a specific installation.
GITHUB_APP_INSTALLATION_ID=
GITHUB_ORG=ops-digit-io
GITHUB_WEBHOOK_SECRET=
# Dedicated repo for the Skills & Playbooks registry (saved to main).
REGISTRY_REPO=du-agent-registry
# The central intake funnel repo — every demand/case is a folder here.
DEMANDS_REPO=du-demands
# Reference-skill import (skills.sh / SkillsMP → GitHub). Extra allowlisted hosts
# to fetch SKILL.md from, comma-separated. Defaults cover skills.sh, GitHub (raw +
# API), and gists. Imports are https-only, host-allowlisted, and human-reviewed.
# SKILL_IMPORT_HOSTS=skills.internal.example.com
# Optional SkillsMP API key — raises the marketplace search rate limit (anonymous
# search works without one). https://skillsmp.com/docs/api
# SKILLSMP_API_KEY=

# --- Model service (M5+) ---
# The portal supports Anthropic and OpenAI. Selection: MODEL_PROVIDER if set and
# its key is present, else Anthropic if keyed, else OpenAI if keyed, else offline.
# MODEL_PROVIDER=anthropic   # anthropic | openai | offline (optional override)

# Anthropic (EU region), server-side only
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=
# ANTHROPIC_MODEL=claude-sonnet-5

# OpenAI, server-side only
OPENAI_API_KEY=
OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o

# --- Job / registry cache store (M3+) ---
KV_REST_API_URL=
KV_REST_API_TOKEN=

# --- Scheduled jobs shared secret (M5+) ---
CRON_SECRET=

# --- Email digest / notifications (M7) ---
# Optional: the weekly review & staleness digest (/api/cron/digest, Mon 07:00).
# Without these the /digest page still works; only the outbound email is inert.
# EMAIL_API_KEY sends via an HTTP email API (Resend-shaped by default); override the
# endpoint with EMAIL_API_URL if using a compatible provider.
EMAIL_API_KEY=
EMAIL_FROM=                 # e.g. "Digital Unit <du-portal@yourco.com>"
# EMAIL_API_URL=https://api.resend.com/emails
# The team/forum recipient for the rolled-up digest (per-owner nudges go to the
# named sponsor/value-owner/requester emails on each demand).
DIGEST_TEAM_EMAIL=

# --- Agent global kill switch (constraint / FR-6.6) ---
# Set to "off" to disable ALL agent tools in one change.
AGENT_TOOLS=on

# --- File attachments (Vercel Blob) ---
# Optional: attach Excel/PPT/PDF to demands. Binaries never enter git (constraint
# #4) — files go to Vercel Blob and the demand keeps a markdown link in its
# ## Attachments section. Without this token, upload is disabled and users can
# still attach files by pasting a link. Provision a store in the Vercel dashboard
# (Storage → Blob) and the token is injected automatically on Vercel.
BLOB_READ_WRITE_TOKEN=
