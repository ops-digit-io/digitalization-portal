{
  "name": "digitalization-portal",
  "version": "0.1.0",
  "private": true,
  "description": "Digital Unit Portal \u2014 control plane for enterprise change demand. Git is the system of record; every artifact is markdown.",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "content:pull": "node scripts/content-pull.mjs",
    "content:check": "node scripts/content-pull.mjs --check",
    "docs": "node scripts/gen-docs.mjs",
    "demo:seed": "node scripts/demo-seed.mjs",
    "demo:clean": "node scripts/demo-seed.mjs --clean",
    "video": "node scripts/video.mjs",
    "mesh:check": "vite-node scripts/mesh-check.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check": "npm run content:pull && npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "autoprefixer": "^10.5.4",
    "playwright": "^1.61.1",
    "postcss": "^8.5.22",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@tiptap/extension-link": "^2.27.2",
    "@tiptap/pm": "^2.27.2",
    "@tiptap/react": "^2.27.2",
    "@tiptap/starter-kit": "^2.27.2",
    "@vercel/blob": "^0.27.3",
    "clsx": "^2.1.1",
    "jose": "^5.10.0",
    "lucide-react": "^1.25.0",
    "mdast-util-from-markdown": "^2.0.3",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-to-string": "^4.0.0",
    "mermaid": "^11.16.0",
    "micromark-extension-gfm": "^3.0.0",
    "next": "^14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.6.0",
    "tiptap-markdown": "^0.8.10"
  }
}
